{
	"schemaVersion": 1,
	"id": "gearbalance",
	"version": "${version}",
	"name": "GearBalance",
	"description": "Set the values of every vanilla tool, weapon and armor piece, with level requirements, armor weight, set bonuses, endgame loot and ready-made presets. Free on Modrinth.",
	"icon": "assets/gearbalance/icon.png",
	"authors": [
		"Schluid"
	],
	"license": "All-Rights-Reserved",
	"contact": {
		"homepage": "https://modrinth.com/mod/gearbalance",
		"sources": "https://github.com/Schluid420/GearBalance",
		"issues": "https://github.com/Schluid420/GearBalance/issues"
	},
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.schluid.gearbalance.GearBalance"
		],
		"client": [
			"io.github.schluid.gearbalance.client.GearBalanceClient"
		],
		"modmenu": [
			"io.github.schluid.gearbalance.client.ModMenuIntegration"
		]
	},
	"mixins": [
		"gearbalance.mixins.json",
		{
			"config": "gearbalance.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
