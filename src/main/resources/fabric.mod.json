{
	"schemaVersion": 1,
	"id": "gearbalance",
	"version": "${version}",
	"name": "GearBalance",
	"description": "Set the values of every vanilla tool, weapon and armor piece, with level requirements, armor weight, set bonuses, endgame loot and ready-made presets. Smithing with upgrades and gem sockets, tailoring with padded armor and bags, new shields with parrying, titanium as endgame material, a glow for fully socketed gear and comfort, death, spawner and HUD options, each with its own switch. Free on CurseForge and GitHub.",
	"icon": "assets/gearbalance/icon.png",
	"authors": [
		"Schluid"
	],
	"license": "All-Rights-Reserved",
	"contact": {
		"homepage": "https://www.curseforge.com/minecraft/mc-mods/gearbalance",
		"sources": "https://github.com/Schluid420/GearBalance",
		"issues": "https://github.com/Schluid420/GearBalance/issues"
	},
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.schluid.gearbalance.GearBalance"
		],
		"client": [
			"io.github.schluid.gearbalance.client.GearBalanceClient"
		],
		"modmenu": [
			"io.github.schluid.gearbalance.client.ModMenuIntegration"
		],
		"jei_mod_plugin": [
			"io.github.schluid.gearbalance.client.compat.GearBalanceJeiPlugin"
		]
	},
	"mixins": [
		"gearbalance.mixins.json",
		{
			"config": "gearbalance.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*",
		"jei": "*"
	}
}
